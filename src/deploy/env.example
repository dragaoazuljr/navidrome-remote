# /etc/navidrome-remote/env — EnvironmentFile do serviço único (spec v1.2)
# Uma linha troca a rota do upstream (D1 ratificada 2026-10-27).
#
#  P1 — LAN crua (.0/24 → LXC 9102):            DEFAULT desta instalação
#  P2 — tailnet (ts-gw :80 + vhost navidrome.lan): alternativa

# ---- listener (o que a LAN aponta) -----------------------------------------
NVRA_LISTEN_ADDR=0.0.0.0
NVRA_LISTEN_PORT=80

# ---- upstream (ROTA: descomente UMA das duas opções) ------------------------
# OPÇÃO P1 — LAN crua (eletiva; .0/24)
NVRA_UPSTREAM=192.168.0.200:4533
#NVRA_UPSTREAM_VHOST=
#
# OPÇÃO P2 — via tailnet (gateway existente; sem daemon novo)
#NVRA_UPSTREAM=100.90.124.50:80
#NVRA_UPSTREAM_VHOST=navidrome.lan

# ---- motor de playback (JSON-IPC) --------------------------------------------
# C1 (dev-workspace): socket do MOCK (unidade fake-mpv-sink)
#   NVRA_MPV_SOCKET=/dev/shm/navidrome-remote-mock-ipc
# C3 (Orange Pi Zero 2W): socket do mpv real (unidade navidrome-remote-mpv)
NVRA_MPV_SOCKET=/dev/shm/mpv-ipc

# ---- espiao NDJSON -----------------------------------------------------------
# (2W/M2: mover para tmpfs quando a política de logs definir)
NVRA_SPY_FILE=/var/lib/navidrome-remote/spy.ndjson

# ---- /api/v1/* (M1: gate de sessão estende isto) -----------------------------
# Token estático opcional. Vazio em M0' (baseline: sessão somente, M1).
NVRA_API_TOKEN=

# ---- conta de serviço Navidrome (Subsonic) — NUNCA no KB (invariante) -------
# Ponteiro de segredo do usuário; o SBC lê daqui e constrói as URLs de stream
# para o mpv. Credenciais jamais chegam ao navegador.
NVRA_NAV_USER=
NVRA_NAV_PASS=

# ---- tetos de proteção da 1GB box -------------------------------------------
NVRA_MAX_REQ_BYTES=16777216
NVRA_MAX_HTML_BYTES=4194304

# keepalive: segundos esperando o proximo pedido numa conexao viva (padrao 60)
NVRA_KEEPALIVE_IDLE=60
